{
	"name": "template-vite-react",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"dev:host": "vite --host",
		"build": "tsc -b && vite build",
		"lint": "ESLINT_USE_FLAT_CONFIG=true eslint \"src/**/*\"",
		"prettier": "prettier --check './**/*.{js,jsx,ts,tsx,css,md,json}' --config ./.prettierrc",
		"prettier:ci": "prettier --write './**/*.{js,jsx,ts,tsx,css,md,json}' --config ./.prettierrc",
		"preview": "vite preview",
		"reset": "rm -rf node_modules package-lock.json && npm i && npm run dev"
	},
	"dependencies": {
		"clsx": "^2.1.1",
		"lucide-react": "^0.577.0",
		"react": "19.2.4",
		"react-dom": "19.2.4",
		"recharts": "3.7.0",
		"tailwind-merge": "^3.5.0"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4.1.4",
		"@technologiestiftung/eslint-config": "0.4.1",
		"@types/node": "24.13.3",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.4",
		"@typescript-eslint/eslint-plugin": "8.67.0",
		"@typescript-eslint/parser": "8.67.0",
		"@vitejs/plugin-react": "4.7.0",
		"eslint": "9.39.5",
		"eslint-plugin-react": "7.37.5",
		"eslint-plugin-react-hooks": "5.2.0",
		"eslint-plugin-react-refresh": "0.5.4",
		"globals": "17.11.0",
		"postcss": "8.4.47",
		"prettier": "3.9.6",
		"sass-embedded": "^1.85.1",
		"tailwindcss": "^4.1.4",
		"typescript": "5.9.3",
		"vite": "6.4.2",
		"vitest": "2.1.9"
	}
}
